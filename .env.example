# Copy to .env.local and adjust for your environment.

# Payload — sign/encrypt sessions. Use a long random string in production!
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://logos:logos@localhost:5433/logoslegal

# MinIO / S3 storage for uploaded images (matches docker-compose.yml defaults)
S3_BUCKET=logoslegal
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
